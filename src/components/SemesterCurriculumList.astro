---
import type { Class } from "../data/types";
import DocumentIcon from "./DocumentIcon.astro";

type Props = {
  semesterCurriculum: Class[];
  className?: string;
};

const { semesterCurriculum, className } = Astro.props;
// A module without a link has no folder in the library yet.
const awaitsResources = semesterCurriculum.some((semesterClass) => !semesterClass.link);
// Modules with resources come first; the sort is stable, so each group keeps the order of the data file.
const orderedCurriculum = [...semesterCurriculum].sort(
  (first, second) => Number(!first.link) - Number(!second.link),
);
---

<div
  class={`mt-4 flex min-h-[30rem] flex-[1_0_auto] bg-beige flex-col gap-5 rounded-lg px-3 py-6 sm:gap-3 sm:px-5 ${
    semesterCurriculum.length === 0 && "bg-opacity-80 items-center justify-center"
  } ${className}`}>
  {
    semesterCurriculum.length > 0 ? (
      orderedCurriculum.map((semesterClass, index) => {
        const isAwaited = !semesterClass.link;
        const label = (
          <>
            <span
              class={`flex-shrink-0 transition-transform group-hover:scale-105 ${
                isAwaited && "opacity-50"
              }`}>
              <DocumentIcon />
            </span>
            <span class={isAwaited ? "opacity-60" : ""}>
              {semesterClass.title}
              {isAwaited && (
                <span class="ml-1 whitespace-nowrap text-xs italic">· no resources yet</span>
              )}
            </span>
          </>
        );
        const layout =
          "curriculum-item -mx-2 flex items-center gap-2 px-2 leading-tight xs:text-lg";

        return semesterClass.link ? (
          <a
            href={semesterClass.link}
            target="_blank"
            rel="noreferrer"
            class={`${layout} group hover:underline`}
            style={`--i: ${index}`}>
            {label}
          </a>
        ) : (
          <div class={layout} style={`--i: ${index}`}>
            {label}
          </div>
        );
      })
    ) : (
      <>
        <p class="text-center text-sm">
          No content has been added yet. Please consider contributing!
        </p>
        <a
          href="https://forms.gle/LEYaSdEo3UVDLxo89"
          class="inline-block rounded-md bg-blue-light px-5 py-1 text-sm font-bold text-beige transition hover:bg-blue-dark dark:bg-blue-dark dark:text-beige dark:hover:bg-[#2B9AAE] dark:hover:text-blue-dark"
          rel="noreferrer"
          target="_blank">
          Contribute
        </a>
      </>
    )
  }
  {
    awaitsResources && (
      <p class="mt-auto pt-4 text-center text-sm">
        Have resources for these modules?{" "}
        <a
          href="https://forms.gle/LEYaSdEo3UVDLxo89"
          class="font-bold underline"
          rel="noreferrer"
          target="_blank">
          Contribute
        </a>
      </p>
    )
  }
</div>
