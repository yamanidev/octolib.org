---
import firstYear from "../data/1CPI";
import thirdYear from "../data/1CS";
import secondYear from "../data/2CPI";
import fourthYear from "../data/2CS";
import fifthYear from "../data/3CS";
import BranchedCurriculumCard from "./BranchedCurriculumCard.astro";
import CurriculumCard from "./CurriculumCard.astro";
import FishSwarmBig from "./FishSwarmBig.astro";
import FishSwarmSmall from "./FishSwarmSmall.astro";
import GlobeDecoration from "./GlobeDecoration.astro";
import PhdCard from "./PhdCard.astro";
import WhaleDecoration from "./WhaleDecoration.astro";
---

<script>
  const cards = document.querySelectorAll(".curriculum-card");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05, rootMargin: "0px 0px -60px 0px" },
  );
  cards.forEach((card) => observer.observe(card));
</script>

<!--
  Each decoration follows the card it overlaps and has no top offset, so it stays where it would sit in the page flow.
  Its negative top margin then pulls it up across that card's bottom edge, which keeps it in place however tall the cards grow.
-->
<section class="relative bg-blue-light">
  <div class="wrapper py-10">
    <CurriculumCard yearCodeName="1CP" className="mb-20" content={firstYear} />
    <FishSwarmSmall
      class="absolute right-10 -mt-[12.5rem] w-72 text-[#1B5F6A] dark:text-[#2EA5B8] md:w-auto"
    />
    <CurriculumCard yearCodeName="2CP" className="mb-20" content={secondYear} />
    <GlobeDecoration class="absolute left-20 -mt-[2.125rem] hidden xl:block" />
    <CurriculumCard yearCodeName="1CS" className="mb-20" content={thirdYear} />
    <FishSwarmBig
      class="absolute right-0 -mt-[10.125rem] w-80 text-[#1B5F6A] dark:text-[#2EA5B8] md:w-auto xl:w-[43rem]"
    />
    <BranchedCurriculumCard yearCodeName="2CS" className="mb-20" content={fourthYear} />
    <WhaleDecoration
      class="absolute left-0 -mt-[22.1875rem] hidden w-96 sm:block md:w-[31.25rem] lg:w-auto"
    />
    <BranchedCurriculumCard yearCodeName="3CS" className="mb-20" content={fifthYear} />
    <PhdCard />
  </div>
</section>
